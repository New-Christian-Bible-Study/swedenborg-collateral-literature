


cat $SOURCES |uconv --callback escape -f UTF-8 -t ASCII |grep -oP "%U[0-9A-F]{4}" |sort -u |cut -c '3-' |while read u; do printf "\\u$u :"; unicode $u |head -1; done
## reveals the following unicode characters in the file[s]:
– :U+2013 EN DASH
‘ :U+2018 LEFT SINGLE QUOTATION MARK
’ :U+2019 RIGHT SINGLE QUOTATION MARK
“ :U+201C LEFT DOUBLE QUOTATION MARK
” :U+201D RIGHT DOUBLE QUOTATION MARK
… :U+2026 HORIZONTAL ELLIPSIS
→ :U+2192 RIGHTWARDS ARROW

## which are replaced by/with: 
sed -Ei s/$'\u00A0'/' '/g fromfile && sed -Ei s/$'\u2013'/--/g fromfile && sed -Ei s/$'\u2014'/--/g fromfile && sed -Ei s/$'\u2018'/\'/g fromfile && sed -Ei s/$'\u2019'/\'/g fromfile && sed -Ei s/$'\u201C'/\"/g fromfile && sed -Ei s/$'\u201D'/\"/g fromfile && sed -Ei s/$'\u2026'/'...'/g fromfile

